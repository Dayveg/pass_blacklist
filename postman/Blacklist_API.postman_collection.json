							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"usuario.bloqueado@ejemplo.com\",\n  \"app_uuid\": \"7a3512b9-e1e3-4c91-9e2b-ef792ef1729b\",\n  \"blocked_reason\": \"Intento reiterado de fuerza bruta y transacciones sospechosas\"\n}"
